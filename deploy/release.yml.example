# EXAMPLE ONLY. This file lives in deploy/ on purpose so NOTHING triggers it.
# To enable releases later: copy it to .github/workflows/release.yml in the repository that hosts RedX
# (review it first; pushing a tag will then build and attach binaries to a GitHub Release).
name: release
on:
  push:
    tags: ["v*"]
  workflow_dispatch: {}
permissions:
  contents: write
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-go@v5
        with: { go-version: "1.22" }
      - run: go vet ./host/... ./cmd/...
      - run: go test -race -count=1 ./host/... ./cmd/...
  build:
    needs: test
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-go@v5
        with: { go-version: "1.22" }
      - name: Cross-compile (linux amd64/arm64/armv7, darwin amd64/arm64, windows amd64/arm64)
        run: VERSION="${GITHUB_REF_NAME:-dev}" scripts/build.sh
      - uses: actions/upload-artifact@v4
        with: { name: redx-dist, path: dist/ }
      - name: Publish release
        if: startsWith(github.ref, 'refs/tags/v')
        uses: softprops/action-gh-release@v2
        with:
          files: |
            dist/*.tar.gz
            dist/*.zip
            dist/SHA256SUMS
