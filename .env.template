# RedXAIHost self-host defaults
NODE_ENV=production
# Optional stable public HTTPS URL for the RedXAIHost control plane.
# Set this when remote VPS/PC agents, GitHub webhooks or local bundle storage must reach the panel.
# Example: REDX_PUBLIC_URL=https://host.example.com
REDX_PUBLIC_URL=
REDX_BIND_HOST=127.0.0.1
WEBSITE_URL=http://127.0.0.1:4200
VITE_WEBSITE_URL=http://127.0.0.1:4200
OWNER_EMAIL=grimvirusoffical@gmail.com
VITE_OWNER_EMAIL=grimvirusoffical@gmail.com

# Generated by scripts/selfhost.mjs on first setup. Never commit your real .env.
BETTER_AUTH_SECRET=
CREDENTIAL_SECRET=

# Local SQLite works without any account. Set a libSQL/Turso URL only if you want remote DB.
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Optional direct Google OAuth for the owner control panel.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_AUTH_ENABLED=false

# Optional legacy managed-auth broker. Leave blank for normal self-hosting.
APPLICATION_ID=
VITE_APPLICATION_ID=
VITE_RUNABLE_AUTH_ISSUER=

# Red-XAI Accounts, the same service as https://github.com/grimvirusoffical-source/red-xai-accounts
# and https://api.red-xai.com/v1/accounts/ (website and Vortex). Set to "off" for local owner
# login only. When the service cannot be reached, the panel keeps the local owner password.
REDX_ACCOUNTS_URL=https://api.red-xai.com/v1/accounts
REDX_ACCOUNTS_SIGNUP_URL=https://red-xai.com/signup

# Hub may embed this panel. "off" sends X-Frame-Options: DENY.
REDX_HUB_ORIGINS=https://red-xai.com
REDX_HUB_URL=https://red-xai.com

# Optional object storage for uploaded ZIP bundles. Git-backed projects do not require it.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# Optional AI deployment planner. The host still accepts manual install/build/start commands without it.
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=

# Auto-start this same computer as a worker when the panel starts.
REDX_AUTO_LOCAL_NODE=true
REDX_DATA_DIR=./data
