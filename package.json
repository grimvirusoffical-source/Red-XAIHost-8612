{
  "name": "redxaihost",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "cd packages/web && bunx vite",
    "dev:desktop": "cd packages/desktop && bunx vite",
    "dev:mobile": "cd packages/mobile && bunx expo start --port $(bun --print \"require('../../__ports.cjs').mobile\")",
    "build": "turbo build",
    "build:web": "cd packages/web && bunx vite build",
    "start": "pm2 startOrRestart ecosystem.config.cjs --update-env",
    "stop": "pm2 delete web-app",
    "lint": "runkit lint",
    "lint:fix": "runkit lint --fix",
    "typecheck": "turbo typecheck",
    "db:generate": "turbo db:generate",
    "db:migrate": "turbo db:migrate",
    "db:push": "turbo db:push",
    "setup:selfhost": "bun scripts/selfhost.mjs --prepare",
    "selfhost": "bun scripts/selfhost.mjs --run",
    "selfhost:setup-and-run": "bun scripts/selfhost.mjs --prepare && bun scripts/selfhost.mjs --run"
  },
  "devDependencies": {
    "@runablehq/runkit": "0.1.1",
    "@tursodatabase/api": "^1.9.2",
    "@types/bun": "1.3.14",
    "oxfmt": "0.54.0",
    "turbo": "2.9.18",
    "typescript": "7.0.1-rc"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1023.0",
    "@libsql/client": "^0.17.2",
    "cloudflare": "^5.2.0",
    "pm2": "^7.0.1"
  }
}
