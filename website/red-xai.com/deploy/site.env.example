# Private server file, mode 0600, outside the release and Git history.
# Fill these only after independent canonical owner/session verification.
REDX_SITE_STATE_DIR=/var/lib/red-xai-site
REDX_SITE_CMS_DATABASE=website_cms
REDX_SITE_CMS_KEY_FILE=/etc/red-xai/site-cms.key
REDX_SITE_CMS_DURABILITY=sync
REDX_SITE_CMS_SINGLE_WRITER=true
REDX_WEBSITE_OWNER_ACCOUNT_IDS=
REDX_SITE_TRUST_CLOUDFLARED=true
